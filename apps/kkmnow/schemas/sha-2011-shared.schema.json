{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kkmnow:dashboard:sha-2011-shared:v1",
  "title": "SHA 2011 dashboard shared payload (v1)",
  "description": "dashboards/sha-2011-shared.json: country list, ASEAN comparators and the SHA 2011 code hierarchy, read by every /dashboard/sha-2011 page. View-only: never committed or published. v1 describes the payload as produced by the data pipeline's exporter.",
  "type": "object",
  "additionalProperties": false,
  "required": ["countries", "asean", "hierarchy"],
  "properties": {
    "countries": {
      "description": "Every country with a page, sorted by name",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name"],
        "properties": {
          "code": {
            "$ref": "#/$defs/iso3"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "asean": {
      "description": "ASEAN comparators for the health financing transition chart",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/iso3"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "transition"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "transition": {
            "$ref": "#/$defs/transition"
          }
        }
      }
    },
    "hierarchy": {
      "description": "Every code of each dimension, in classification order. Every code needs codes.<code> in both locales",
      "type": "object",
      "additionalProperties": false,
      "required": ["hf", "fs", "hp", "hc"],
      "properties": {
        "hf": {
          "$ref": "#/$defs/entries"
        },
        "fs": {
          "$ref": "#/$defs/entries"
        },
        "hp": {
          "$ref": "#/$defs/entries"
        },
        "hc": {
          "$ref": "#/$defs/entries"
        }
      }
    },
    "data_last_updated": {
      "description": "Publication date of the GHED edition: YYYY-MM or YYYY-MM-DD. Optional until the exporter emits it",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
    }
  },
  "$defs": {
    "iso3": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "code": {
      "type": "string",
      "pattern": "^(hf|fs|hp|hc)[0-9]*(nec)?$"
    },
    "transition": {
      "description": "[year, CHE per capita (USD), OOP % of CHE]",
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "items": false,
        "minItems": 3
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "parent", "sha"],
        "properties": {
          "code": {
            "$ref": "#/$defs/code"
          },
          "parent": {
            "description": "Parent code, null at level 1",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/code"
              }
            ]
          },
          "sha": {
            "description": "Official SHA 2011 notation, e.g. HF.1.2.nec",
            "type": "string",
            "pattern": "^(HF|FS|HP|HC)(\\.[0-9]+)*(\\.nec)?$"
          }
        }
      }
    }
  }
}
